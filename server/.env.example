# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=nexafrica_creative_ecosystem_secret_key_2026
PORT=5001

# ---------------------------------------------------------------------------
# PostgreSQL / Supabase Database Configuration
# ---------------------------------------------------------------------------
# Option A: Supabase Session Pooler (Recommended for Render IPv4 deployment)
# Get this from: Supabase Dashboard -> Connect -> Session Pooler (Port 5432 or 6543)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Option B: Local PostgreSQL
DATABASE_URL=postgresql://fidelorwasa@localhost:5432/nexafrica_db

# Fallback: If DATABASE_URL is not set, the app falls back to sqlite:///nexafrica_dev.db

# CORS Allowed Origins (comma-separated frontend URLs, e.g. your Render Static Site URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Admin / Security
ADMIN_API_KEY=nexafrica-admin-key-2026
